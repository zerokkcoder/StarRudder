# MySQL 8（本地数据库名 / 用户 / 密码均为 star_rudder）
DATABASE_URL=mysql://star_rudder:star_rudder@localhost:3306/star_rudder?charset=utf8mb4

# Auth.js 会话签名密钥（生成：openssl rand -base64 32）
AUTH_SECRET=replace-with-a-random-secret

# 站点公开地址（SEO canonical / sitemap 使用）
NEXT_PUBLIC_SITE_URL=https://starrudder.cc

# Google Search Console 验证串（在控制台获取后填入，留空则不输出该 meta）
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# RSS 抓取接口密钥（调用 /api/rss/fetch 时用 Authorization: Bearer <值>）
CRON_SECRET=replace-with-a-random-secret
